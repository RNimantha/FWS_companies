{
  "name": "fwc-companies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src server tests scripts vite.config.ts eslint.config.js tsconfig.json package.json index.html",
    "test:brand": "node scripts/brand-check.mjs",
    "assets:brand": "node scripts/optimize-brand-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@netlify/functions": "^6.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
